# Flixtor TV build environment template
#
# Copy to .env and fill in what you need. .env is git-ignored; this file is not.
#   cp .env.example .env
#
# This file is a template only. Never commit real values, and never put a signing
# key or an API key in a file that reaches Git.
#
# Gradle does not read .env by itself. Export the values first:
#   set -a; . ./.env; set +a
#   ./gradlew :app:assembleDebug
# or pass them inline:
#   TV_INTRODB_API_KEY=idb_... ./gradlew :app:assembleRelease

# --- IntroDB skip segments ---------------------------------------------------
# Your IntroDB API key, used only to contribute marked timestamps. Reading skip
# segments never needs a key. Leave blank for a normal build that cannot
# contribute but still reads, marks and skips.
#
# The key is compiled into the APK, so anyone with a released build can extract
# it. Use a dedicated key you can revoke without affecting your main account.
TV_INTRODB_API_KEY=

# --- Release versioning ------------------------------------------------------
# CI sets these automatically. Local release builds can override them.
TV_VERSION_NAME=0.2.0
TV_VERSION_CODE=2

# --- Release signing ---------------------------------------------------------
# Generated automatically by tools/build_release.py into
# ~/.local/share/flixtor-tv/. Supply all four to sign a release build; without
# TV_KEYSTORE the release build is left unsigned. Never commit these.
TV_KEYSTORE=
TV_STORE_PASSWORD=
TV_KEY_ALIAS=personal-tv
TV_KEY_PASSWORD=

# --- Problem reporting -------------------------------------------------------
# The Vercel relay that receives user-triggered diagnostic reports. Blank means
# reporting is shown as unavailable, which is a valid configuration.
TV_REPORT_URL=

# --- CI only -----------------------------------------------------------------
# Written by CI; leave blank locally.
TV_COMMIT_SHA=
TV_KEYSTORE_BASE64=
